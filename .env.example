# Connection string for Railway PostgreSQL Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nvhub"

# Better Auth Configuration
# Generate a random key using: openssl rand -base64 32
BETTER_AUTH_SECRET="some-random-long-secret-key-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Application URL (used for redirects and links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data Layer Mode:
# - "sandbox": uses Zustand and browser local storage (default, safe)
# - "database": uses server actions, prisma, and PostgreSQL
NEXT_PUBLIC_DATA_MODE="sandbox"
